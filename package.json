{
  "name": "isabela-studio",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter web dev",
    "dev:studio": "pnpm --filter studio dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "check": "pnpm -r check"
  }
}
