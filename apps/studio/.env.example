# Copia este archivo como `.env` (no se sube a git).

# ID del proyecto en sanity.io/manage (sin él, el Studio compila con un valor de relleno pero no conecta).
SANITY_STUDIO_PROJECT_ID=
# Dataset a usar.
SANITY_STUDIO_DATASET=production

# Solo para `pnpm --filter studio seed`: token con permisos de escritura (Editor)
# creado en sanity.io/manage → API → Tokens. Nunca lo subas a git.
SANITY_WRITE_TOKEN=
