# Copia este fichero a `.env` para desarrollo local.
# En Cloudflare Pages, define las mismas variables en Settings → Environment variables.

# URL pública del sitio (canonical, hreflang, sitemap). Sin barra final.
PUBLIC_SITE_URL=https://isabela-studio.pages.dev

# Sanity. Si PUBLIC_SANITY_PROJECT_ID está vacío, el sitio compila sin contenido del CMS.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-11-01
