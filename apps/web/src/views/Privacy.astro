---
/** Política de privacidad: texto del CMS (página fija `privacy`) con la maqueta de lectura común. */
import LegalPage from '../components/legal/LegalPage.astro';
import { getPage } from '../lib/sanity/api';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await getPage('privacy');
---

<LegalPage page={page} locale={locale} route="privacy" titleKey="page.privacy.title" />
