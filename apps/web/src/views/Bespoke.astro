---
/**
 * A medida / Encargos: apertura (antetítulo, gran título y entradilla), un pequeño índice
 * con los procesos de cada línea (Prêt-à-porter · Flamenca) cuando hay más de uno, los
 * pasos de cada proceso (bloques `stepsBlock` con su ancla) y la llamada a contactar.
 * Si el documento `bespoke` no existe, apertura con los textos de i18n y contacto.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import ContactCta from '../components/contact/ContactCta.astro';
import { pad2, stepsAnchors } from '../components/blocks/layout';
import { pickLocale, t, type Locale } from '../i18n/utils';
import { getPage } from '../lib/sanity/api';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await getPage('bespoke');

const title = pickLocale(page?.title, locale) || t(locale, 'page.bespoke.title');
const intro = pickLocale(page?.intro, locale) || t(locale, 'page.bespoke.intro');
const body = page?.body ?? [];
const endsInCta = body.some((b) => b?._type === 'ctaBlock');

// Mismo cálculo que el BlockRenderer, que pone estos ids a los bloques de pasos.
const sections = [...stepsAnchors(body).values()].map((anchor) => ({
  href: `#${anchor}`,
  label: t(locale, anchor === 'flamenca' ? 'filter.flamenca' : 'filter.pretAPorter'),
}));
const indexLabel = t(locale, 'bespoke.indexLabel');

const seoTitle = pickLocale(page?.seo?.title, locale) || title;
const seoDescription = pickLocale(page?.seo?.description, locale) || intro;
---

<BaseLayout locale={locale} title={seoTitle} description={seoDescription}>
  <article class="bespoke">
    <header class="bespoke-hero">
      <p class="bespoke-hero__eyebrow eyebrow">{t(locale, 'bespoke.eyebrow')}</p>
      <h1 class="bespoke-hero__title" data-reveal>{title}</h1>
      <p class="bespoke-hero__intro" data-reveal>{intro}</p>

      {
        sections.length > 1 && (
          <nav class="bespoke-index" aria-label={indexLabel} data-reveal>
            <p class="bespoke-index__label eyebrow" aria-hidden="true">
              {indexLabel}
            </p>
            <ol class="bespoke-index__list" role="list">
              {sections.map((s, i) => (
                <li>
                  <a class="bespoke-index__link" href={s.href}>
                    <span class="bespoke-index__num" aria-hidden="true">
                      {pad2(i + 1)}
                    </span>
                    <span class="bespoke-index__text">{s.label}</span>
                    <span class="bespoke-index__arrow" aria-hidden="true">
                      ↓
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </header>

    <BlockRenderer blocks={body} locale={locale} class="bespoke-body" />

    {!endsInCta && <ContactCta cta={null} locale={locale} />}
  </article>
</BaseLayout>

<style>
  .bespoke-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    inline-size: min(100% - 2 * var(--gutter), var(--container-max));
    margin-inline: auto;
    padding-block: var(--space-l) var(--space-2xl);
  }

  .bespoke-hero__eyebrow {
    color: var(--color-text-muted);
  }

  .bespoke-hero__title {
    margin-block: var(--space-xs) var(--space-l);
    font-size: clamp(3.5rem, 2rem + 9vw, 10rem);
    font-style: italic;
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .bespoke-hero__intro {
    max-inline-size: 26ch;
    margin-inline-start: calc(100% / 6);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    text-wrap: pretty;
  }

  /* ---------- Índice de procesos ---------- */
  .bespoke-index {
    margin-block-start: var(--space-xl);
  }

  .bespoke-index__label {
    margin-block-end: var(--space-xs);
    color: var(--color-text-muted);
  }

  .bespoke-index__list {
    border-block-start: var(--border-hairline);
  }

  .bespoke-index__list li {
    border-block-end: var(--border-hairline);
  }

  .bespoke-index__link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--space-s);
    padding-block: var(--space-s);
    text-decoration: none;
  }

  .bespoke-index__link:hover {
    color: inherit;
  }

  .bespoke-index__num {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-accent);
  }

  .bespoke-index__text {
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: var(--leading-snug);
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 95%;
    background-size: 0% 1px;
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .bespoke-index__arrow {
    font-size: var(--step-1);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .bespoke-index__link:is(:hover, :focus-visible) .bespoke-index__text {
    background-size: 100% 1px;
  }

  .bespoke-index__link:is(:hover, :focus-visible) .bespoke-index__arrow {
    color: var(--color-accent);
    transform: translateY(0.2em);
  }

  @media (min-width: 48em) {
    .bespoke-hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
      padding-block-start: var(--space-xl);
    }

    .bespoke-hero__eyebrow {
      grid-column: 1 / -1;
    }

    .bespoke-hero__title {
      grid-column: 1 / span 8;
      margin-block-end: 0;
      font-size: clamp(4rem, 1rem + 8vw, 11rem);
    }

    .bespoke-hero__intro {
      grid-column: 9 / -1;
      margin-inline-start: 0;
      padding-block-end: 0.6em;
    }

    .bespoke-index {
      grid-column: 3 / -1;
      margin-block-start: var(--space-2xl);
    }

    .bespoke-index__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--gutter);
    }

    .bespoke-index__link {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      padding-block: var(--space-m);
    }
  }
</style>
