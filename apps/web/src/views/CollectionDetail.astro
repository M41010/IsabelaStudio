---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagePlaceholder from '../components/PagePlaceholder.astro';
import { localizedPath, pickLocale, t, type Locale } from '../i18n/utils';
import { getCollection } from '../lib/sanity/api';


interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const collection = await getCollection(slug);
const title = pickLocale(collection?.title, locale) ?? slug;
const lineLabel =
  collection?.line === 'flamenca'
    ? t(locale, 'filter.flamenca')
    : collection?.line === 'pret-a-porter'
      ? t(locale, 'filter.pretAPorter')
      : undefined;
---

<BaseLayout locale={locale} title={title}>
  <PagePlaceholder eyebrow={lineLabel} title={title} intro={t(locale, 'page.collectionDetail.intro')}>
    <p><a href={localizedPath('collections', locale)}>{t(locale, 'cta.allCollections')}</a></p>
  </PagePlaceholder>
</BaseLayout>
