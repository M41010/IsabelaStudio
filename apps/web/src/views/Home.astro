---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagePlaceholder from '../components/PagePlaceholder.astro';
import { localizedPath, t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale}>
  <PagePlaceholder title={t(locale, 'page.home.title')} intro={t(locale, 'page.home.intro')}>
    <p><a href={localizedPath('collections', locale)}>{t(locale, 'cta.allCollections')}</a></p>
    <p><a href={localizedPath('contact', locale)}>{t(locale, 'cta.contact')}</a></p>
  </PagePlaceholder>
</BaseLayout>
