---
/** Política de cookies: texto del CMS (página fija `cookies`) con la maqueta de lectura común. */
import LegalPage from '../components/legal/LegalPage.astro';
import { getPage } from '../lib/sanity/api';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await getPage('cookies');
---

<LegalPage page={page} locale={locale} route="cookies" titleKey="page.cookies.title" />
