---
/** Aviso legal: texto del CMS (página fija `legal-notice`) con la maqueta de lectura común. */
import LegalPage from '../components/legal/LegalPage.astro';
import { getPage } from '../lib/sanity/api';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await getPage('legal-notice');
---

<LegalPage page={page} locale={locale} route="legalNotice" titleKey="page.legalNotice.title" />
