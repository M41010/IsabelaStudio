---
import BaseLayout from '../layouts/BaseLayout.astro';
import PagePlaceholder from '../components/PagePlaceholder.astro';
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const title = t(locale, 'page.legalNotice.title');
---

<BaseLayout locale={locale} title={title}>
  <PagePlaceholder title={title} intro={t(locale, 'page.legal.placeholder')} />
</BaseLayout>
