---
import { localizedPath, matchRoute, t, type AlternateUrl, type Locale, type RouteKey, type UiKey } from '../../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
  alternates: AlternateUrl[];
  /** "Prensa" solo aparece si hay entradas publicadas. */
  hasPress?: boolean;
  /**
   * `overlay` (portada): cabecera transparente con texto claro sobre el vídeo.
   * - Sin JS: se coloca en absoluto sobre la portada y se va con el scroll.
   * - Con JS (script mínimo, solo en esta variante): queda fija y, al dejar atrás el
   *   elemento `[data-header-overlay-until]`, pasa a la cabecera normal (fondo marfil).
   * Contraste AA en ambos estados: degradado oscuro propio bajo el texto claro.
   */
  variant?: 'default' | 'overlay';
}

const { locale, alternates, hasPress = false, variant = 'default' } = Astro.props;
const overlay = variant === 'overlay';

type NavKey = Extract<RouteKey, 'collections' | 'about' | 'bespoke' | 'press' | 'contact'>;
const items: NavKey[] = ['collections', 'about', 'bespoke', ...(hasPress ? (['press'] as const) : []), 'contact'];

const current = matchRoute(Astro.url.pathname)?.key;
const isCurrent = (key: NavKey) => current === key || (key === 'collections' && current === 'collectionDetail');
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-site-header>
  <div class="site-header__inner">
    <a class="site-header__logo" href={localizedPath('home', locale)} aria-label={t(locale, 'a11y.homeLink')}>
      Isabela Studio
    </a>

    <!--
      Menú: Popover API, sin JavaScript. En móvil el botón abre el panel
      (Esc y clic fuera lo cierran; el navegador gestiona aria-expanded).
      En escritorio el panel se muestra en línea por CSS.
    -->
    <button class="site-header__toggle" type="button" popovertarget="site-menu" popovertargetaction="show">
      {t(locale, 'nav.menu')}
    </button>

    <nav id="site-menu" class="site-menu" popover aria-label={t(locale, 'a11y.mainNav')}>
      <button class="site-menu__close" type="button" popovertarget="site-menu" popovertargetaction="hide">
        {t(locale, 'nav.close')}
      </button>
      <ul class="site-menu__list" role="list">
        {
          items.map((key) => (
            <li>
              <a href={localizedPath(key, locale)} aria-current={isCurrent(key) ? 'page' : undefined}>
                {t(locale, `nav.${key}` as UiKey)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-menu__lang">
        <LangSwitcher locale={locale} alternates={alternates} />
      </div>
    </nav>
  </div>
</header>

{
  overlay && (
    <script is:inline type="module">
      // `type="module"` lo difiere hasta que la portada (más abajo) ya está en el DOM.
      (() => {
        const header = document.querySelector('[data-site-header]');
        const until = document.querySelector('[data-header-overlay-until]');
        if (!header || !until || !('IntersectionObserver' in window)) return;
        header.setAttribute('data-pinned', '');
        new IntersectionObserver(
          ([entry]) => header.toggleAttribute('data-solid', !entry.isIntersecting),
          { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
        ).observe(until);
      })();
    </script>
  )
}

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    width: min(100% - 2 * var(--gutter), var(--container-max));
    min-height: var(--header-height);
    margin-inline: auto;
  }

  .site-header__logo {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .site-header__toggle,
  .site-menu__close {
    border: 0;
    background: none;
    padding: var(--space-2xs);
    margin-inline-end: calc(-1 * var(--space-2xs));
    font-size: var(--step--1);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  /* ---------- Móvil: panel a pantalla completa ---------- */
  .site-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--space-s) var(--gutter) var(--space-xl);
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
    z-index: var(--z-menu);
    flex-direction: column;
    gap: var(--space-xl);
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-out),
      display var(--duration-base) allow-discrete,
      overlay var(--duration-base) allow-discrete;
  }

  .site-menu:popover-open {
    display: flex;
    opacity: 1;
  }

  @starting-style {
    .site-menu:popover-open {
      opacity: 0;
    }
  }

  .site-menu__close {
    align-self: flex-end;
    min-height: calc(var(--header-height) - 2 * var(--space-s));
  }

  .site-menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .site-menu__list a {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: var(--leading-tight);
    text-decoration: none;
  }

  .site-menu__list a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  /* ---------- Escritorio: navegación en línea ---------- */
  @media (min-width: 60em) {
    .site-header__toggle,
    .site-menu__close {
      display: none;
    }

    .site-menu,
    .site-menu:popover-open {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--space-l);
      width: auto;
      height: auto;
      padding: 0;
      background: none;
      opacity: 1;
      overflow: visible;
    }

    .site-menu__list {
      flex-direction: row;
      gap: var(--space-m);
    }

    .site-menu__list a {
      font-family: var(--font-body);
      font-size: var(--step--1);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
    }
  }

  /* ---------- Variante overlay (portada) ---------- */
  .site-header--overlay {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .site-header--overlay[data-pinned] {
    position: fixed;
  }

  /* Estado transparente: texto marfil sobre un degradado oscuro propio, que garantiza
     AA (≥ 4,5:1) aunque el fotograma de debajo sea claro. */
  .site-header--overlay:not([data-solid]) {
    --color-focus: var(--color-ivory);
    color: var(--color-ivory);
    text-shadow: 0 0 1.5rem oklch(0% 0 0 / 0.35);
  }

  .site-header--overlay::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    block-size: calc(var(--header-height) * 1.75);
    background: linear-gradient(
      to bottom,
      oklch(0% 0 0 / 0.6),
      oklch(0% 0 0 / 0.45) 40%,
      oklch(0% 0 0 / 0)
    );
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .site-header--overlay .site-header__inner {
    position: relative;
  }

  .site-header--overlay:not([data-solid]) :is(.site-header__logo, .site-header__toggle):hover {
    color: inherit;
    text-decoration: underline;
  }

  /* La portada ya muestra el logo en grande: el de la cabecera aparece al pasar al estado normal. */
  .site-header--overlay:not([data-solid]) .site-header__logo {
    opacity: 0;
    visibility: hidden;
  }

  .site-header--overlay .site-header__logo {
    transition:
      opacity var(--duration-base) var(--ease-out),
      visibility var(--duration-base) allow-discrete;
  }

  /* Estado normal tras la portada. */
  .site-header--overlay[data-solid] {
    background-color: var(--color-bg);
    color: var(--color-text);
    box-shadow: 0 1px 0 var(--color-line);
  }

  .site-header--overlay[data-solid]::before {
    opacity: 0;
  }

  /* El panel del menú móvil es marfil: sin la sombra de texto heredada. */
  .site-header--overlay .site-menu {
    text-shadow: none;
  }

  @media (min-width: 60em) {
    .site-header--overlay:not([data-solid]) .site-menu {
      text-shadow: inherit;
      color: inherit;
    }

    .site-header--overlay:not([data-solid]) .site-menu a:hover {
      color: inherit;
      text-decoration: underline;
    }
  }
</style>
