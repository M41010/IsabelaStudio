---
/** Cabecera semántica provisional para las vistas mientras no hay diseño ni contenido. */
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
}

const { title, intro, eyebrow } = Astro.props;
---

<section class="placeholder container">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {intro && <p class="placeholder__intro">{intro}</p>}
  <slot />
</section>

<style>
  .placeholder {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .placeholder__intro {
    max-width: var(--container-text);
    font-size: var(--step-1);
    color: var(--color-text-muted);
  }
</style>
